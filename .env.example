# Copy to .env for local values. NEVER commit real .env values.
# Only needed when running the backend against real PostgreSQL
# (SPRING_PROFILES_ACTIVE=postgres); the dev/test profiles use in-memory H2
# and need none of these.

# --- PostgreSQL (postgres profile) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/habit_tracker
DATABASE_USERNAME=app
DATABASE_PASSWORD=change-me

# --- Session cookie ---
# Set true when serving over HTTPS in production.
AUTH_COOKIE_SECURE=false

# --- CORS ---
# Comma-separated allow-list of frontend origins. NEVER use "*".
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth (dev convenience only) ---
# Log raw password-reset tokens to the console because no email provider is
# wired up yet. Keep false outside development.
APP_DEV_EXPOSE_RESET_TOKEN=false
